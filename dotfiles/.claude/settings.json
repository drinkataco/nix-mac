{
  "includeCoAuthoredBy": false,
  "deniedMcpServers": [
    { "serverName": "claude.ai Vercel" },
    { "serverName": "claude.ai Zoom for Claude" },
    { "serverName": "claude.ai Slack" },
    { "serverName": "claude.ai EULER" },
    { "serverName": "claude.ai monday.com" },
    { "serverName": "claude.ai Linear" },
    { "serverName": "claude.ai Intercom" },
    { "serverName": "claude.ai HubSpot" },
    { "serverName": "claude.ai Figma" },
    { "serverName": "claude.ai Canva" },
    { "serverName": "claude.ai Box" },
    { "serverName": "claude.ai Asana" }
  ],
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git shortlog:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(diff:*)",
      "Bash(wc:*)",
      "Bash(pwd:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)"
    ]
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/osh/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "effortLevel": "xhigh",
  "skipWorkflowUsageWarning": true,
  "editorMode": "vim",
  "tui": "fullscreen"
}
